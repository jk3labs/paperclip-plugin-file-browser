{
  "name": "@jk3labs/paperclip-plugin-file-browser",
  "version": "0.4.3",
  "description": "A Paperclip plugin for browsing files in the default workspace",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/index.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "paperclip",
    "plugin",
    "file-browser"
  ],
  "dependencies": {
    "@paperclipai/plugin-sdk": "^1.0.0",
    "archiver": "^8.0.0",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT"
}